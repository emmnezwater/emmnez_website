---
import { nav, site } from '@/data/site';
const { pathname } = Astro.url;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname === href;
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-header>
  <div class="nav-shell">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src="/images/logo-mark.png" width="40" height="60" alt="" />
      <span class="brand-name">Emmnez <small>Water Solution Ltd</small></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map(item => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <a class="button button-small desktop-quote" href="/contact.html">Request a quote <span aria-hidden="true">↗</span></a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span></span><span></span>
    </button>
  </div>
</header>
<div class="menu-backdrop" data-menu-backdrop></div>
<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" aria-hidden="true" data-mobile-menu>
  <div class="mobile-menu-index">Menu / 05</div>
  {nav.map((item, index) => (
    <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
      <span>0{index + 1}</span>{item.label}
    </a>
  ))}
  <div class="mobile-menu-contact">
    <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</nav>

---
import type { Project } from '@/data/site';
const { project } = Astro.props as { project: Project };
---
<article class="project-card" data-reveal>
  <img src={project.image} alt={`${project.title} water engineering project`} loading="lazy" width="900" height="1200" />
  <div class="project-info">
    <div class="project-meta"><span>{project.category}</span><span>{project.metric}</span></div>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
  </div>
</article>
